    </div>
  </div>

  <div class="live-cities" id="liveCities">
    <small class="text-muted">No active visitors right now</small>
  </div>

  <p class="fw-bold text-light mt-3 mb-1">Last Visit: <span id="lastVisitors">0</span></p>
  <p class="fw-bold text-light mb-0">Current: <span id="currentVisitors">0</span></p>
</div>

<!-- 📈 FOOTFALL (daily / monthly) -->
<div class="card p-3 mb-3">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">📈 Website Footfall</h5>

    <div class="btn-group btn-group-sm" role="group" aria-label="Footfall range">
      <button type="button" class="btn btn-primary footfall-tab" data-range="daily">Daily</button>
      <button type="button" class="btn btn-outline-primary footfall-tab" data-range="monthly">Monthly</button>
    </div>
  </div>

  <div class="footfall-stats">
    <div class="footfall-stat">
      <small class="text-muted">Today</small>
      <b id="ffTodayVisitors">0</b>
      <span id="ffTodayVisits">0 visits</span>
    </div>

    <div class="footfall-stat">
      <small class="text-muted">This month</small>
      <b id="ffMonthVisitors">0</b>
      <span id="ffMonthVisits">0 visits</span>
    </div>

    <div class="footfall-stat">
      <small class="text-muted">All time</small>
      <b id="ffTotalVisitors">0</b>
      <span id="ffTotalVisits">0 visits</span>
    </div>
  </div>

  <div class="ff-scroll">
    <table class="ff-table">
      <thead>
        <tr>
          <th>Period</th>
          <th>Visitors</th>
          <th>New</th>
