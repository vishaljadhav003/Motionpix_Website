<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>
  <script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>


<style>
body {
  font-family: 'Poppins', sans-serif;
  background: #0f172a;
  color: #fff;
}
/* DARK MODE TEXT FIX */
body:not(.light-mode) .text-muted {
  color: #cbd5e1 !important; /* light gray */
}

body:not(.light-mode) h5 {
  color: #ffffff;
}
/* HEADER */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

/* CARD */
.card {
  background: linear-gradient(145deg, #1e293b, #0f172a);
  color: #fff; /* Bootstrap's dark card text was invisible on the dark background */
  border-radius: 18px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.6);
  border: none;
}

/* STAT CARDS */
.stat-card {
  text-align: center;
  padding: 20px;
}
.stat-card h3 {
  font-size: 28px;
}



/* TABLE */
.table {
  border-radius: 10px;
  overflow: hidden;
}

/* BADGES */
.badge-pending {
  background: orange;
  padding: 6px 12px;
  border-radius: 20px;
}
.badge-completed {
  background: #22c55e;
  padding: 6px 12px;
  border-radius: 20px;
}

/* BUTTON */
.btn-action {
  border-radius: 20px;
  padding: 5px 10px;
}

/* SEARCH */
.search-box input {
  border-radius: 20px;
}

/* NOTIFICATION */
.toast-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 999;
}

/* LIGHT MODE */
.light-mode {
  background: #f1f5f9;
  color: #111;
}
.light-mode .card {
  background: #ffffff;
  color: #111;
}

.light-mode .table {
  background: #fff;
  color: #111;
}

.light-mode .table thead {
  background: #e2e8f0;
}

.light-mode .badge-pending {
  background: #f59e0b;
}

.light-mode .badge-completed {
  background: #16a34a;
}
.light-mode .card,.stat-card,
.light-mode #notifBox,
.light-mode .toast {
  background: #ffffff !important;
  color: #111 !important;
}

.light-mode #notifBox strong,
.light-mode #notifBox small {
  color: #111 !important;
}

.light-mode .text-muted {
  color: #555 !important;
}

.light-mode .text-light {
  color: #111 !important;
}

.notif-item {
  border-radius: 8px;
}

.light-mode .notif-item {
  background: #f8fafc;
}

#clearBtn i {
  color: #94a3b8;
  transition: 0.2s;
}

#clearBtn i:hover {
  color: #ef4444;
  transform: scale(1.2);
}

.card {
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
}

.card:hover {
  transform: translateY(-5px);
  transition: 0.3s;
}
body:not(.light-mode) h5,
body:not(.light-mode) small {
  color: #e2e8f0 !important;
}
.table-hover tbody tr:hover {
  background: rgba(255,255,255,0.05);
}

#notifBox {
  border-radius: 15px;
  backdrop-filter: blur(15px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

/* =========================================================
   LIVE VISITORS
   ========================================================= */

.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 12px;
  border-radius: 20px;
  background: rgba(34,197,94,0.15);
  color: #22c55e;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  animation: livePulse 1.8s infinite;
}

.live-now {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 0;
}

.live-count {
  min-width: 64px;
  font-size: clamp(34px, 6vw, 48px);
  font-weight: 700;
  line-height: 1;
  color: #22c55e;
  font-variant-numeric: tabular-nums;
}

.live-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.live-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
  padding: 5px 12px;
  border-radius: 20px;
  background: rgba(255,255,255,0.08);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.live-chip b {
  color: #22c55e;
}

.light-mode .live-chip {
  background: rgba(0,0,0,0.06);
}

.live-marker {
  background: transparent;
  border: 0;
}

.live-pulse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #22c55e;
  color: #04130a;
  font-size: 11px;
  font-weight: 700;
  box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
  animation: livePulse 1.8s infinite;
}

@keyframes livePulse {
  70% {
    box-shadow: 0 0 0 14px rgba(34,197,94,0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(34,197,94,0);
  }
}

/* =========================================================
   FOOTFALL
   ========================================================= */

.footfall-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.footfall-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(255,255,255,0.06);
}

.light-mode .footfall-stat {
  background: rgba(0,0,0,0.05);
}

.footfall-stat b {
  font-size: clamp(22px, 4vw, 30px);
  line-height: 1.1;
  color: #3b82f6;
  font-variant-numeric: tabular-nums;
}

.footfall-stat span {
  font-size: 12px;
  opacity: 0.75;
}

.ff-scroll {
  width: 100%;
  max-height: 360px;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}

.ff-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  font-variant-numeric: tabular-nums;
}

.ff-table th,
.ff-table td {
  padding: 8px 12px;
  text-align: right;
  white-space: nowrap;
  border-bottom: 1px solid rgba(128,128,128,0.25);
}

.ff-table th:first-child,
.ff-table td:first-child {
  text-align: left;
}

@media (max-width: 575.98px) {
  .footfall-stats {
    gap: 8px;
  }

  .footfall-stat {
    padding: 10px;
  }

  .ff-table {
    font-size: 13px;
  }

  .ff-table th,
  .ff-table td {
    padding: 7px 8px;
  }
}

@media (max-width: 380px) {
  .footfall-stats {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   RESPONSIVE DESIGN
   ========================================================= */

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

body {
  min-width: 0;
}

.container {
  width: 100%;
  max-width: 100%;
}

/* ================= HEADER ================= */

.header {
  width: 100%;
  min-width: 0;
  gap: 15px;
  flex-wrap: wrap;
}

.header > h4 {
  flex: 0 0 auto;
}

.header > div {
  min-width: 0;
}

.header .d-flex {
  flex-wrap: wrap;
}

.header .btn {
  white-space: nowrap;
}

/* ================= KPI CARDS ================= */

.stat-card {
  min-width: 0;
}

.stat-card h2 {
  font-size: clamp(24px, 3vw, 32px);
  word-break: break-word;
}

/* ================= SEARCH ================= */

.search-box {
  min-width: 0;
}

#searchInput {
  min-width: 0;
  width: 100%;
}

form.row {
  width: 100%;
  min-width: 0;
}

form.row > div {
  min-width: 0;
}

/* ================= ANALYTICS ================= */

.card {
  min-width: 0;
  max-width: 100%;
}

.card canvas {
  max-width: 100%;
}

/* ================= TABLE ================= */

.table-responsive {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.table-responsive > .table {
  min-width: 850px;
  margin-bottom: 0;
}

.table th,
.table td {
  white-space: nowrap;
  vertical-align: middle;
}

.table td:nth-child(5) {
  white-space: normal;
  min-width: 180px;
  max-width: 250px;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* ================= NOTIFICATION ================= */

#notifBox {
  max-width: calc(100vw - 30px) !important;
  width: 300px !important;
  max-height: min(420px, calc(100vh - 90px));
  overflow-y: auto;
  overflow-x: hidden;
}

#notifList {
  min-width: 0;
  overflow-wrap: anywhere;
}

.notif-item {
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* ================= VISITOR CARD ================= */

#map {
  width: 100%;
  max-width: 100%;
  height: 400px;
  border-radius: 15px;
  overflow: hidden;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 991.98px) {

  .container {
    padding-left: 18px !important;
    padding-right: 18px !important;
  }

  .header {
    align-items: flex-start;
  }

  .header > h4 {
    width: 100%;
  }

  .header > div {
    width: 100%;
  }

  .header .d-flex {
    justify-content: flex-start;
  }

  .stat-card {
    padding: 18px !important;
  }

  .card {
    border-radius: 16px;
  }

  #map {
    height: 350px;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767.98px) {

  .container {
    padding: 14px !important;
  }

  .header {
    margin-bottom: 16px;
    gap: 12px;
  }

  .header > h4 {
    font-size: 20px;
    margin-bottom: 0;
  }

  .header > div {
    width: 100%;
  }

  .header .d-flex {
    width: 100%;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px !important;
  }

  .header .d-flex > * {
    width: 100%;
  }

  .header .btn {
    width: 100%;
    font-size: 13px;
    padding: 8px 10px;
  }

  /* notification button + box */

  #notifBox {
    position: fixed !important;
    top: 70px !important;
    right: 12px !important;
    left: 12px !important;
    width: auto !important;
    max-width: none !important;
  }

  /* KPI */

  .stat-card {
    padding: 16px !important;
  }

  .stat-card h2 {
    font-size: 26px;
  }

  /* Search */

  form.row {
    margin-left: 0;
    margin-right: 0;
  }

  form.row > div {
    width: 100%;
  }

  form.row .btn {
    min-height: 44px;
  }

  /* Analytics */

  .card.p-4 {
    padding: 16px !important;
  }

  .card.p-3 {
    padding: 10px !important;
  }

  .card .d-flex.justify-content-between {
    align-items: flex-start !important;
    gap: 10px;
  }

  .card .d-flex.justify-content-between > div {
    min-width: 0;
  }

  .card h5 {
    font-size: 17px;
  }

  .card small {
    font-size: 11px;
  }

  /* Chart */

  #myChart {
    max-height: 260px;
  }

  /* Table */

  .table-responsive {
    margin: 0;
    border-radius: 10px;
  }

  .table-responsive > .table {
    min-width: 850px;
  }

  .table th,
  .table td {
    font-size: 13px;
  }

  /* Visitor stats */

  #map {
    height: 300px !important;
    border-radius: 12px;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 575.98px) {

  .container {
    padding: 10px !important;
  }

  .header > h4 {
    font-size: 18px;
  }

  .header .d-flex {
    grid-template-columns: 1fr 1fr;
  }

  .header .btn {
    font-size: 12px;
    padding: 7px 6px;
  }

  .stat-card h2 {
    font-size: 24px;
  }

  .card {
    border-radius: 14px;
  }

  #map {
    height: 280px !important;
  }

  #notifBox {
    top: 65px !important;
  }
}

/* =========================================================
   VERY SMALL DEVICES
   ========================================================= */

@media (max-width: 380px) {

  .container {
    padding: 8px !important;
  }

  .header .d-flex {
    grid-template-columns: 1fr;
  }

  .header .btn {
    font-size: 13px;
  }

  .stat-card {
    padding: 14px !important;
  }

  .stat-card h2 {
    font-size: 22px;
  }

  #map {
    height: 250px !important;
  }
}
</style>

<script>
let notifCount = 0;

/* 🌙 THEME TOGGLE */
function toggleTheme() {
  document.body.classList.toggle("light-mode");

  const btn = document.getElementById("themeBtn");

  if (document.body.classList.contains("light-mode")) {
    btn.innerText = "☀️ Light";
    localStorage.setItem("theme", "light");
  } else {
    btn.innerText = "🌙 Dark";
    localStorage.setItem("theme", "dark");
  }
}

/* 🔄 LOAD THEME */
window.onload = () => {
  const theme = localStorage.getItem("theme");
  const btn = document.getElementById("themeBtn");

  if (theme === "light") {
    document.body.classList.add("light-mode");
    btn.innerText = "☀️ Light";
  } else {
    btn.innerText = "🌙 Dark";
  }
};

/* 🔔 NOTIFICATION TOGGLE */
function toggleNotif(){
  document.getElementById("notifBox").classList.toggle("d-none");
}

/* 🔥 SOCKET (REAL TIME FIXED) */
const socket = io();

socket.on("newContact", (data) => {

  notifCount++;
  document.getElementById("notifCount").innerText = notifCount;

  // add notification item
  const notifList = document.getElementById("notifList");

  notifList.innerHTML = `
  <div class="mb-2 p-2 border-bottom notif-item">
    <strong>${data.fname} ${data.lname}</strong><br>
    <small class="text-muted">${data.email}</small>
  </div>
` + notifList.innerHTML;

  // add table row
const row = `
  <tr>

    <td>${data.id}</td>

    <td>
      ${data.fname || ''} ${data.lname || ''}
    </td>

    <td>
      ${data.company || '—'}
    </td>

    <td>
      ${data.email || '—'}
    </td>

    <td>
      ${data.services || '—'}
    </td>

    <td>
      ${data.budget || '—'}
    </td>

    <td style="
      max-width:200px;
      white-space:normal;
      overflow-wrap:anywhere;
      word-break:break-word;
    ">
      ${data.msg || ''}
    </td>

    <td>
      ${data.contact || '—'}
    </td>

    <td>
      <span class="badge-pending">
        Pending
      </span>
    </td>

    <td>

      <a
        href="/api/complete/${data.id}"
        class="btn btn-success btn-sm"
      >
        ✔
      </a>

      <a
        href="/api/delete/${data.id}"
        class="btn btn-danger btn-sm"
      >
        🗑
      </a>

    </td>

  </tr>
`;

  document.getElementById("tableData")
    .insertAdjacentHTML("afterbegin", row);
});
</script>


</head>
<body>

<div class="container py-4">

<!-- HEADER -->
<div class="header">
  <h4>🚀 MotionPix Admin</h4>
  <div class="mb-3">
  <a href="/api/admin" class="btn btn-primary">📩 Contact</a>
  <a href="/api/admin/careers" class="btn btn-warning">💼 Careers</a>
  <a href="/api/admin/content" class="btn btn-info">📝 Content</a>
  <a href="/api/admin/team" class="btn btn-success">👥 Team</a>
</div>

  <div class="d-flex gap-2">
      <button id="themeBtn" onclick="toggleTheme()" class="btn btn-dark">
        🌙 Dark Mode
      </button>
  <div class="position-relative">

  <button class="btn btn-dark" onclick="toggleNotif()">
    🔔 <span id="notifCount" class="badge bg-danger">0</span>
  </button>
<div id="notifBox"
     class="card p-2 d-none"
     style="width:300px; position:absolute; right:0; top:45px; z-index:999; background:inherit;">

    <strong>Notifications</strong>
    <hr>

    <div id="notifList">
      <p class="text-muted mb-0">No notifications</p>
    </div>

  </div>
</div>
    <a href="/api/logout" class="btn btn-danger d-flex align-items-center gap-2"  onclick="return confirmLogout()">
      Logout <i class="bi bi-box-arrow-right"></i> 
    </a>
</div>
</div>


<!-- 🔥 PRO KPI + ANALYTICS -->
<div class="row g-3 mb-4">

  <!-- TOTAL -->
  <div class="col-md-4">
    <div class="card p-4 stat-card" style="background: linear-gradient(135deg,#1e293b,#0b1220); border-left:4px solid #3b82f6;">
      <small class="text-muted">Total Inquiries</small>
      <h2 class="mb-0"><%= data.length %></h2>
    </div>
  </div>

  <!-- PENDING -->
  <div class="col-md-4">
    <div class="card p-4 stat-card" style="background: linear-gradient(135deg,#1e293b,#0b1220); border-left:4px solid orange;">
      <small class="text-muted">Pending</small>
      <h2 class="mb-0" style="color:orange;"><%= data.filter(d=>d.status==='pending').length %></h2>
    </div>
  </div>

  <!-- COMPLETED -->
  <div class="col-md-4">
    <div class="card p-4 stat-card" style="background: linear-gradient(135deg,#1e293b,#0b1220); border-left:4px solid #22c55e;">
      <small class="text-muted">Completed</small>
      <h2 class="mb-0" style="color:#22c55e;"><%= data.filter(d=>d.status==='completed').length %></h2>
    </div>
  </div>

</div>


<!-- SEARCH -->
<form method="GET" action="/api/admin" class="mb-3 row g-2">
  <div class="col-md-4 position-relative" style="margin-left:150px;">

    <!-- 🔍 INPUT -->
    <input type="text"
           id="searchInput"
           name="search"
           placeholder="Search by name/email..."
           value="<%= search %>"
           class="form-control pe-5 fw-bold">

    <!-- ❌ CLEAR BUTTON -->
    <span id="clearBtn"
          onclick="clearSearch()"
          style="position:absolute; right:15px; top:50%; transform:translateY(-50%); cursor:pointer; display:none;">
      <i class="bi bi-x-circle-fill"></i>
    </span>

  </div>

  <div class="col-md-3">
    <select name="status" class="form-control fw-bold">
      <option value="">All</option>
      <option value="pending" <%= status==='pending'?'selected':'' %>>Pending</option>
      <option value="completed" <%= status==='completed'?'selected':'' %>>Completed</option>
    </select>
  </div>

  <div class="col-md-2">
    <button class="btn btn-primary w-100 fw-bold">Search</button>
  </div>
</form>



<!-- 📊 ANALYTICS CARD -->
<div class="card p-4 mb-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="mb-0">📊 Analytics Overview</h5>
      <small class="text-muted">Real-time inquiry insights</small>
    </div>

    <span class="badge bg-primary px-3 py-2">Live</span>
  </div>

  <div style="background:#0b1220; padding:15px; border-radius:12px;">
    <canvas id="myChart" height="100"></canvas>
  </div>

</div>

<!-- TABLE -->
<div class="card p-3">
<div class="table-responsive">

<table class="table table-dark table-hover align-middle">
<thead>
<tr>
  <th>#</th>
  <th>Name</th>
  <th>Company</th>
  <th>Email</th>
  <th>Service</th>
  <th>Budget</th>
  <th>Message</th>
  <th>Contact</th>
  <th>Status</th>
  <th>Action</th>
</tr>
</thead>

<tbody id="tableData">

<% data.forEach((item,index)=>{ %>

<tr>

  <td class="fw-bold"><%= index+1 %></td>

  <td class="fw-bold">
    <%= item.fname %> <%= item.lname %>
  </td>

  <td class="fw-bold">
    <%= item.company || "—" %>
  </td>

  <td class="fw-bold">
    <%= item.email %>
  </td>

  <td class="fw-bold">
    <%= item.services %>
  </td>

  <td class="fw-bold">
    <%= item.budget || "—" %>
  </td>

  <td class="fw-bold" style="
    max-width: 200px;
    word-wrap: break-word;
    white-space: normal;
    word-break: break-word;
  ">
    <%= item.msg %>
  </td>

  <td class="fw-bold">
    <%= item.contact || "—" %>
  </td>

  <td class="fw-bold">

    <% if(item.status === 'pending'){ %>

      <span class="badge-pending fw-bold">
        Pending
      </span>

    <% } else { %>

      <span class="badge-completed fw-bold">
        Completed
      </span>

    <% } %>

  </td>

  <td class="fw-bold">

    <% if(item.status === 'pending'){ %>

      <a
        href="/api/complete/<%= item.id %>"
        class="btn btn-success btn-action"
      >
        ✔
      </a>

    <% } %>

    <a
      href="/api/delete/<%= item.id %>"
      class="btn btn-danger btn-action"
    >
      🗑
    </a>

  </td>

</tr>

<% }) %>

</tbody>

</table>

</div>
</div>
<ul id="visitorList"></ul>

<!-- 🟢 VISITOR STATS + LIVE NOW -->
<div class="card p-3 mb-3">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">📊 Visitor Stats</h5>

    <span class="live-badge">
      <span class="live-dot"></span>
