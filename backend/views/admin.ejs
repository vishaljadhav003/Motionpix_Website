<script>
const searchInput = document.getElementById("searchInput");
const clearBtn = document.getElementById("clearBtn");

// show/hide X button
function toggleClearBtn(){
  if(searchInput.value.length > 0){
    clearBtn.style.display = "block";
  } else {
    clearBtn.style.display = "none";
  }
}

// clear input
function clearSearch(){
  searchInput.value = "";
  clearBtn.style.display = "none";
  searchInput.focus();
}

// event
searchInput.addEventListener("input", toggleClearBtn);

// initial check (page reload case)
window.addEventListener("load", toggleClearBtn);
</script>
<script>
let map;
let markersLayer; // all stored visitor markers live here so they can be cleared/rebuilt cleanly
let liveLayer; // live (currently online) visitors — green pulsing markers
let latestLive = null; // last live snapshot, drawn again once the map is ready

// Escapes text before it is placed inside popups / HTML
function esc(value) {
  return String(value ?? "").replace(/[&<>"']/g, (ch) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  }[ch]));
}

// =========================
// EXISTING VISITORS (BLUE) — always redrawn fresh from the DB, so a
// visitor removed/changed outside this open tab (e.g. a manual DB
// reset) can never leave a stale marker sitting on the map.
// =========================
async function renderAllVisitors() {
  markersLayer.clearLayers();

  const res = await fetch("/api/all-visitors");
  const visitors = await res.json();

  visitors.forEach(v => {
    if (!v.lat || !v.lon) return;

    L.circleMarker([v.lat, v.lon], {
      radius: 8,
      fillColor: "#00d4ff",
      color: "#00d4ff",
      fillOpacity: 0.8
    })
    .addTo(markersLayer)
    .bindPopup(`
      📍 Existing Visitor<br>
      ${esc(v.city) || "Unknown"}, ${esc(v.country)}
    `);
  });
}

// =========================
// LIVE VISITORS (GREEN) — who is on the website right now
// =========================
function renderLive(data) {
  latestLive = data;

  const visitors = Array.isArray(data && data.visitors) ? data.visitors : [];
  const total = data && Number.isFinite(data.count) ? data.count : visitors.length;

  document.getElementById("liveCount").innerText = total;

  // group visitors by place, so 10 people from Pune become one marker
  const groups = new Map();

  visitors.forEach(v => {
    const hasLocation = Number.isFinite(v.lat) && Number.isFinite(v.lon);
    const key = hasLocation ? `${v.city || ""}|${v.country || ""}` : "unknown";
    const label = hasLocation
      ? [v.city, v.country].filter(Boolean).join(", ") || "Unknown location"
      : "Locating…";

    if (!groups.has(key)) {
      groups.set(key, {
        label,
        count: 0,
        lat: hasLocation ? v.lat : null,
        lon: hasLocation ? v.lon : null
      });
    }

    groups.get(key).count += 1;
  });

  const sorted = Array.from(groups.values()).sort((a, b) => b.count - a.count);

  // chips
  const chips = document.getElementById("liveCities");

  chips.innerHTML = sorted.length
    ? sorted.slice(0, 8).map(g =>
        `<span class="live-chip">${esc(g.label)} <b>${g.count}</b></span>`
      ).join("")
    : '<small class="text-muted">No active visitors right now</small>';

  // markers
  if (!liveLayer) return;

  liveLayer.clearLayers();

  sorted.forEach(g => {
    if (g.lat === null || g.lon === null) return;

    L.marker([g.lat, g.lon], {
      icon: L.divIcon({
        className: "live-marker",
        html: `<span class="live-pulse">${g.count > 1 ? g.count : ""}</span>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11]
      }),
      zIndexOffset: 1000
    })
    .addTo(liveLayer)
    .bindPopup(`
      🟢 Live now<br>
      ${esc(g.label)}<br>
      Active: ${g.count}
    `);
  });
}

async function loadLiveVisitors() {
  try {
    const res = await fetch("/api/live-visitors");

    if (res.ok) {
      renderLive(await res.json());
    }
  } catch (err) {
    console.error("Live visitors load error:", err);
  }
}

// realtime updates from the server
socket.on("liveVisitors", renderLive);

window.addEventListener("load", async () => {

  map = L.map("map").setView([20.5937, 78.9629], 5);

 L.tileLayer(
  "https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=cb1_47e9_1_f1e9691d9be459325951394d",
  {
    attribution:
      '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, © <a href="https://carto.com/attribution/">CARTO</a>',
    maxZoom: 20
  }
).addTo(map);

  markersLayer = L.layerGroup().addTo(map);
  liveLayer = L.layerGroup().addTo(map);

  // draw whatever arrived over the socket before the map was ready
  if (latestLive) {
    renderLive(latestLive);
  } else {
    loadLiveVisitors();
  }

  // safety net in case the socket connection drops
  setInterval(loadLiveVisitors, 30000);

  await loadTotalVisitors();
  await renderAllVisitors();

  // =========================
  // LATEST VISITOR (RED)
  // =========================
  socket.on("visitorUpdate", async (data) => {
    // Rebuild the whole marker set from the DB first (clears any stale
    // marker), then highlight this visit on top of the fresh set.
    await renderAllVisitors();

    document.getElementById("currentVisitors").innerText = data.total;
    document.getElementById("lastVisitors").innerText = data.total;

    if (!data.lat || !data.lon) return;

    L.circleMarker([data.lat, data.lon], {
      radius: 11,
      fillColor: "#ff3b3b",
      color: "#ff3b3b",
      fillOpacity: 0.95
    })
    .addTo(markersLayer)
    .bindPopup(`
      🔥 Latest Visitor<br>
      ${esc(data.city) || "Unknown"}, ${esc(data.country)}<br>
      Total Visitors: ${esc(data.total)}
    `)
    .openPopup();
  });

});


// =========================
// LOAD VISITOR STATS
// =========================
async function loadTotalVisitors() {
  const res = await fetch("/api/track-visitor");
  const data = await res.json();

  document.getElementById("currentVisitors").innerText = data.total;
  document.getElementById("lastVisitors").innerText = data.last;
}

// =========================
// FOOTFALL (daily / monthly)
// =========================
let footfallData = { daily: [], monthly: [] };
let footfallRange = "daily";

function formatFootfallPeriod(period, range) {
  const parts = String(period).split("-").map(Number);

  const date = range === "monthly"
    ? new Date(parts[0], parts[1] - 1, 1)
    : new Date(parts[0], parts[1] - 1, parts[2]);

  return date.toLocaleDateString(
    "en-IN",
    range === "monthly"
      ? { month: "short", year: "numeric" }
      : { day: "2-digit", month: "short", year: "numeric" }
  );
}

function renderFootfall() {
  const rows = footfallData[footfallRange] || [];
  const body = document.getElementById("footfallBody");

  body.innerHTML = rows.length
    ? rows.map(r => `
        <tr>
          <td>${esc(formatFootfallPeriod(r.period, footfallRange))}</td>
          <td>${r.visitors}</td>
          <td>${r.newVisitors}</td>
          <td>${Math.max(r.visitors - r.newVisitors, 0)}</td>
          <td>${r.visits}</td>
        </tr>
      `).join("")
    : '<tr><td colspan="5" class="text-center">No visits recorded yet</td></tr>';
}

async function loadFootfall() {
  try {
    const res = await fetch("/api/footfall");

    if (!res.ok) return;

    const data = await res.json();
    const s = data.summary || {};

    footfallData = {
      daily: data.daily || [],
      monthly: data.monthly || []
    };

    document.getElementById("ffTodayVisitors").innerText = s.todayVisitors || 0;
    document.getElementById("ffTodayVisits").innerText = `${s.todayVisits || 0} visits`;
    document.getElementById("ffMonthVisitors").innerText = s.monthVisitors || 0;
    document.getElementById("ffMonthVisits").innerText = `${s.monthVisits || 0} visits`;
    document.getElementById("ffTotalVisitors").innerText = s.totalVisitors || 0;
    document.getElementById("ffTotalVisits").innerText = `${s.totalVisits || 0} visits`;

    renderFootfall();
  } catch (err) {
    console.error("Footfall load error:", err);
  }
}

document.querySelectorAll(".footfall-tab").forEach(btn => {
  btn.addEventListener("click", () => {
    footfallRange = btn.dataset.range;

    document.querySelectorAll(".footfall-tab").forEach(b => {
      const active = b === btn;
      b.classList.toggle("btn-primary", active);
      b.classList.toggle("btn-outline-primary", !active);
    });

    renderFootfall();
  });
});

window.addEventListener("load", loadFootfall);
setInterval(loadFootfall, 60000);
</script>
</body>
