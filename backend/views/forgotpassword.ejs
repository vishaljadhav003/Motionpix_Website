<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Admin OTP Authentication - MotionPix</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      margin: 0;
    }

    body {
      min-height: 100vh;
      min-height: 100svh;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 20px;

      background:
        radial-gradient(
          circle at top left,
          #1e293b,
          #0a0f1c
        );

      color: #ffffff;
      font-family: Poppins, sans-serif;

      overflow-x: hidden;
    }

    .auth-box {
      width: 100%;
      max-width: 420px;

      padding: 35px;

      border-radius: 20px;

      background: rgba(255, 255, 255, 0.07);

      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);

      border: 1px solid rgba(255, 255, 255, 0.1);

      box-shadow: 0 25px 90px rgba(0, 0, 0, 0.8);
    }

    .brand {
      margin-bottom: 5px;

      text-align: center;

      font-size: 24px;
      font-weight: 600;

      color: #ffffff;
    }

    .subtitle {
      margin-bottom: 25px;

      text-align: center;

      font-size: 13px;

      color: rgba(255, 255, 255, 0.6);
    }

    .form-control {
      width: 100%;

      padding: 12px;

      border-radius: 12px;

      background: rgba(255, 255, 255, 0.05);

      border: 1px solid rgba(255, 255, 255, 0.15);

      color: #ffffff;

      font-family: inherit;
    }

    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.4);
    }

    .form-control:focus {
      background: rgba(255, 255, 255, 0.08);

      border-color: #3b82f6;

      color: #ffffff;

      box-shadow: none;
      outline: none;
    }

    /* Fixed Admin Email */
    .admin-email {
      cursor: default;

      user-select: none;

      -webkit-user-select: none;

      caret-color: transparent;
    }

    .admin-email:focus {
      border-color: rgba(255, 255, 255, 0.15);

      background: rgba(255, 255, 255, 0.05);

      box-shadow: none;
    }

    .btn-auth {
      width: 100%;

      padding: 12px;

      border: none;
      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          #3b82f6,
          #22c55e
        );

      color: #ffffff;

      font-family: inherit;
      font-weight: 600;

      cursor: pointer;

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    .btn-auth:hover {
      opacity: 0.95;

      transform: translateY(-1px);
    }

    .btn-auth:active {
      transform: translateY(0);
    }

    .otp-input {
      text-align: center;

      letter-spacing: 8px;

      font-size: 24px;
      font-weight: 600;
    }

    .timer {
      margin-top: 15px;

      text-align: center;

      font-size: 13px;

      color: #fbbf24;
    }

    .regenerate {
      display: none;

      width: 100%;

      margin-top: 12px;

      padding: 10px;

      background: transparent;

      border: 1px solid rgba(255, 255, 255, 0.2);

      border-radius: 10px;

      color: #60a5fa;

      font-family: inherit;

      cursor: pointer;

      transition:
        background 0.2s ease,
        border-color 0.2s ease;
    }

    .regenerate:hover {
      background: rgba(96, 165, 250, 0.08);

      border-color: rgba(96, 165, 250, 0.5);
    }

    .back-link {
      display: block;

      margin-top: 20px;

      text-align: center;

      color: #60a5fa;

      text-decoration: none;

      font-size: 13px;
    }

    .back-link:hover {
      color: #93c5fd;
    }

    .error-message {
      margin-bottom: 15px;

      padding: 10px;

      border-radius: 10px;

      background: rgba(239, 68, 68, 0.15);

      border: 1px solid rgba(239, 68, 68, 0.3);

      color: #fca5a5;

      font-size: 13px;

      line-height: 1.5;
    }

    .success-message {
      margin-bottom: 15px;

      padding: 10px;

      border-radius: 10px;

      background: rgba(34, 197, 94, 0.15);

      border: 1px solid rgba(34, 197, 94, 0.3);

      color: #86efac;

      font-size: 13px;

      line-height: 1.5;
    }

    /* =========================
       TABLET / MOBILE
    ========================= */

    @media (max-width: 576px) {
      body {
        padding: 15px;
      }

      .auth-box {
        max-width: 100%;

        padding: 28px 22px;

        border-radius: 18px;
      }

      .brand {
        font-size: 21px;
      }

      .subtitle {
        margin-bottom: 22px;

        font-size: 12px;
      }

      .form-control {
        padding: 11px;
      }

      .otp-input {
        font-size: 21px;

        letter-spacing: 6px;
      }
    }

    /* =========================
       SMALL MOBILE
    ========================= */

    @media (max-width: 380px) {
      body {
        padding: 12px;
      }

      .auth-box {
        padding: 24px 18px;

        border-radius: 16px;
      }

      .brand {
        font-size: 19px;
      }

      .subtitle {
        font-size: 11px;
      }

      .form-control {
        padding: 10px;

        font-size: 14px;
      }

      .btn-auth {
        padding: 11px;

        font-size: 14px;
      }

      .otp-input {
        font-size: 19px;

        letter-spacing: 5px;
      }

      .back-link {
        font-size: 12px;
      }
    }

    /* =========================
       VERY SMALL DEVICES
    ========================= */

    @media (max-width: 320px) {
      body {
        padding: 10px;
      }

      .auth-box {
        padding: 22px 15px;
      }

      .brand {
        font-size: 18px;
      }

      .otp-input {
        font-size: 18px;

        letter-spacing: 4px;
      }
    }
  </style>
</head>

<body>

  <div class="auth-box">

    <div class="brand">
      🚀 MotionPix Admin
    </div>

    <div class="subtitle">
      Secure OTP Authentication
    </div>

    <% if (typeof error !== "undefined" && error) { %>

      <div class="error-message">
        <%= error %>
      </div>

    <% } %>

    <% if (typeof success !== "undefined" && success) { %>

      <div class="success-message">
        <%= success %>
      </div>

    <% } %>


    <% if (typeof otpSent !== "undefined" && otpSent) { %>

      <!-- ================= OTP VERIFY ================= -->

      <form
        method="POST"
        action="/api/verify-otp"
      >

        <input
          type="hidden"
          name="email"
          value="info@motionpixindia.com"
        >

        <input
          type="text"
          name="otp"
          class="form-control otp-input"
          placeholder="••••••"
          inputmode="numeric"
          maxlength="6"
          autocomplete="one-time-code"
          required
        >

        <button
          type="submit"
          class="btn-auth mt-3"
        >
          Verify OTP
        </button>

      </form>


      <div
  class="timer"
  id="timer"
>
  <% if (typeof otpExpired !== "undefined" && otpExpired) { %>
    OTP expired. Generate a new OTP.
  <% } else { %>
    OTP expires in <strong>30</strong> seconds
  <% } %>
</div>


      <form
        method="POST"
        action="/api/forgot-password/regenerate"
        id="regenerateForm"
      >

        <button
          type="submit"
          class="regenerate"
          id="regenerateButton"
        >
          Regenerate New OTP
        </button>

      </form>

<script>
  const timer = document.getElementById("timer");
  const regenerateButton =
    document.getElementById("regenerateButton");

  let seconds = 30;

  <% if (typeof otpExpired !== "undefined" && otpExpired) { %>

    timer.innerHTML =
      "OTP expired. Generate a new OTP.";

    regenerateButton.style.display = "block";

  <% } else { %>

    const interval = setInterval(() => {
      seconds--;

      timer.innerHTML =
        "OTP expires in <strong>" +
        seconds +
        "</strong> seconds";

      if (seconds <= 0) {
        clearInterval(interval);

        timer.innerHTML =
          "OTP expired. Generate a new OTP.";

        regenerateButton.style.display =
          "block";
      }
    }, 1000);

  <% } %>
</script>


    <% } else { %>

      <!-- ================= FIXED ADMIN EMAIL ================= -->

      <form
        method="POST"
        action="/api/forgot-password"
      >

        <input
          type="email"
          name="email"
          class="form-control admin-email mb-3"
          value="info@motionpixindia.com"
          readonly
          tabindex="-1"
          autocomplete="off"
          aria-label="Registered admin email"
        >

        <button
          type="submit"
          class="btn-auth"
        >
          Send OTP
        </button>

      </form>

    <% } %>


    <a
      href="/api/login"
      class="back-link"
    >
      Back to Login
    </a>

  </div>

</body>
</html>